---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FaderCurveDemo from "../components/FaderCurveDemo.astro";
import RoutingDiagram from "../components/RoutingDiagram.astro";
import { homeCopy, type Locale } from "../i18n/home";
import { faAndroid, faApple, faLinux, faWindows } from "@fortawesome/free-brands-svg-icons";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const lang: Locale = Astro.url.pathname.startsWith(`${base}ja/`) ? "ja" : "en";
const copy = homeCopy[lang];
const title = "JUMBLEQ — Faderless 2CH Digital Mixer";
const description = copy.description;
const heroImage = `${base}assets/jumbleq-beta.jpg`;
const photoBreakImage = `${base}assets/jumbleq-beta-dscf8275.jpg`;
const platforms = [
  { label: "Windows", icon: faWindows },
  { label: "macOS", icon: faApple },
  { label: "iOS / iPadOS", icon: faApple },
  { label: "Android", icon: faAndroid },
  { label: "Linux", icon: faLinux },
].map(({ label, icon }) => ({
  label,
  width: icon.icon[0],
  height: icon.icon[1],
  path: icon.icon[4] as string,
}));
---

<BaseLayout {title} {description} {lang}>
  <Header {base} {lang} />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-photo" style={`--section-image: url(${heroImage})`} role="img" aria-label={copy.heroImageAlt}></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 id="hero-title"><span class="hero-title-line">{copy.heroTitle[0]}</span><br /><em class="hero-title-line">{copy.heroTitle[1]}</em></h1>
        <p class="hero-copy">{copy.heroCopy[0]}<br />{copy.heroCopy[1]}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#concept">{copy.discover} <span>↓</span></a>
          <a class="button button-ghost" href="https://github.com/yamamo2shun1/JUMBLEQ">{copy.viewGithub} ↗</a>
        </div>
      </div>
    </section>

    <section class="manifesto" id="concept">
      <p class="section-label">01 / CONCEPT</p>
      <div class="concept-layout">
        <div class="concept-copy">
          <h2>{copy.conceptTitle.map((line) => <span class="concept-title-chunk">{line}</span>)}</h2>
          <p>{copy.conceptBody}</p>
        </div>
        <img class="concept-device" src={`${base}assets/jumbleq-device-cutout.png`} width="847" height="805" alt={copy.conceptDeviceAlt} loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="feature-section" id="features" aria-labelledby="features-title">
      <div class="section-head">
        <p class="section-label">02 / FEATURES</p>
        <h2 id="features-title">{copy.featuresTitle[0]}<br />{copy.featuresTitle[1]}</h2>
      </div>
      <div class="feature-grid">
        <article class="feature-card feature-card-lead">
          <p class="feature-number">01</p>
          <div class="feature-icon switch-icon" aria-hidden="true">
            <span class="switch-icon-row switch-icon-row-top"><i></i><i class="yellow"></i><i class="yellow"></i><i></i></span>
            <span class="switch-icon-row switch-icon-row-bottom"><i></i><i class="yellow"></i><i></i><i></i><i class="yellow"></i><i></i></span>
          </div>
          <h3>{copy.featureTitles[0]}</h3>
          <p>{copy.featureBodies[0]}</p>
        </article>
        <article class="feature-card">
          <p class="feature-number">02</p>
          <div class="patch-visual"><RoutingDiagram {lang} /></div>
          <h3>{copy.featureTitles[1]}</h3>
          <p>{copy.featureBodies[1]}</p>
        </article>
        <article class="feature-card">
          <p class="feature-number">03</p>
          <div class="bit-display" aria-hidden="true"><p><strong>24</strong><span>bit</span></p><p><strong>48/96</strong><span>kHz</span></p></div>
          <h3>{copy.featureTitles[2]}</h3>
          <p>{copy.featureBodies[2]}</p>
        </article>
        <article class="feature-card">
          <p class="feature-number">04</p>
          <div class="device-list" aria-hidden="true">
            {platforms.map((platform) => (
              <span>
                <svg viewBox={`0 0 ${platform.width} ${platform.height}`} focusable="false"><path d={platform.path}></path></svg>
                <small>{platform.label}</small>
              </span>
            ))}
          </div>
          <h3>{copy.featureTitles[3]}</h3>
          <p>{copy.featureBodies[3]}</p>
        </article>
      </div>
    </section>

    <section class="operation-section" id="controls" aria-labelledby="controls-title">
      <div class="operation-intro">
        <p class="section-label">03 / CONTROLS</p>
        <h2 id="controls-title"><span>{copy.controlsTitle[0]}</span><br /><span>{copy.controlsTitle[1]}</span></h2>
        <p>{copy.controlsIntro}</p>
      </div>

      <div class="operation-grid">
        <article class="operation-card">
          <p class="operation-tag">FADER CURVE</p>
          <h3>{copy.curveTitle[0]}<br />{copy.curveTitle[1]}</h3>
          <p>{copy.curveBody}</p>
          <FaderCurveDemo {lang} />
        </article>

        <article class="operation-card operation-card-yellow">
          <p class="operation-tag">MULTIPLE SWITCHES</p>
          <h3>{copy.switchesTitle[0]}<br />{copy.switchesTitle[1]}</h3>
          <p>{copy.switchesBody}</p>
          <div class="aux-keys" aria-hidden="true"><i>A</i><i>A/B</i><i>B/A</i><i>B</i></div>
        </article>

        <article class="operation-card">
          <p class="operation-tag">MIDI</p>
          <h3>{copy.midiTitle[0]}<br />{copy.midiTitle[1]}</h3>
          <p>{copy.midiBody}</p>
          <div class="press-meter" aria-hidden="true"><span></span><span></span><span></span><span></span><b>RELEASE</b><b>PRESS</b></div>
        </article>

        <article class="operation-card operation-card-wide">
          <div>
            <p class="operation-tag">AUDIO SEND / RETURN &amp; DVS</p>
            <h3>{copy.digitalTitle[0]}<br />{copy.digitalTitle[1]}</h3>
          </div>
          <div class="signal-modes" role="img" aria-label="USBセンド・リターンとDVSの信号経路">
            <div class="signal-mode">
              <small>SEND / RETURN</small>
              <div class="signal-flow signal-flow-loop">
                <span>JUMBLEQ</span>
                <i><b>SEND →</b><b>← RETURN</b></i>
                <strong>PC / FX</strong>
              </div>
            </div>
            <div class="signal-mode">
              <small>DVS</small>
              <div class="signal-flow signal-flow-dvs">
                <span>CONTROL<br />VINYL</span><b>→</b><em>JUMBLEQ</em><b>⇄</b><strong>DJ<br />SOFTWARE</strong>
              </div>
            </div>
          </div>
          <p class="operation-detail">{copy.digitalBody}</p>
        </article>
      </div>

      <a class="operation-guide-link" href="https://github.com/yamamo2shun1/JUMBLEQ/blob/main/Docs/user-guide/operation-guide.md">{copy.operationGuide} <span>↗</span></a>
    </section>

    <section class="photo-break" aria-label={copy.photoAlt}>
      <div class="photo-break-image" style={`--section-image: url(${photoBreakImage})`}></div>
      <div class="photo-break-copy"><p>MAGNETIC SWITCHES.<br />NEW WAYS TO PLAY.</p></div>
    </section>

    <section class="configurator-section" id="configurator" aria-labelledby="configurator-title">
        <div class="configurator-copy">
          <p class="section-label">04 / CONFIGURATOR</p>
          <h2 id="configurator-title"><span>{copy.configuratorTitle[0]}</span><span>{copy.configuratorTitle[1]}</span></h2>
        <p>{copy.configuratorBody}</p>
        <a class="text-link" href="https://configurator.jumbleq.io/">{copy.openConfigurator} <span>↗</span></a>
        <small>{copy.browserNote}</small>
      </div>
      <a class="configurator-visual" href="https://configurator.jumbleq.io/" aria-label={copy.openConfigurator}>
        <img src={`${base}assets/configurator-concept.png`} alt={copy.configuratorAlt} loading="lazy" />
        <span>OPEN WEB APP ↗</span>
      </a>
    </section>

    <section class="spec-section" id="specs" aria-labelledby="specs-title">
      <div class="spec-intro">
        <figure class="spec-photo">
          <img src={`${base}assets/spec-photo-dscf8316.jpg`} alt={copy.specPhotoAlt} loading="lazy" />
          <figcaption><p class="section-label">05 / SPECIFICATIONS</p><h2 id="specs-title">{copy.specsTitle[0]}<br />{copy.specsTitle[1]}</h2></figcaption>
        </figure>
      </div>
      <dl class="spec-list">
        <div><dt>ANALOG I/O</dt><dd><strong>2 STEREO IN / 2 STEREO OUT + 1 HEADPHONE OUT</strong><span>3.5 mm stereo jacks (Stereo Thonkiconn)</span><a class="spec-detail-link" href="https://github.com/yamamo2shun1/JUMBLEQ/blob/main/Docs/reference/audio-spec.md">DETAILED AUDIO SPECIFICATIONS ↗</a></dd></div>
        <div><dt>USB-C AUDIO / MIDI INTERFACE</dt><dd><strong>2 STEREO IN / 2 STEREO OUT + MIDI I/O</strong><span>24-bit / 48 or 96 kHz / class-compliant</span></dd></div>
        <div><dt>RGB LED METERS</dt><dd><strong>2 × 5-SEGMENT VU METERS</strong><span>Channel Fader A/B level &amp; position indicators</span></dd></div>
        <div><dt>OLED DISPLAYS</dt><dd><strong>128 × 64 + 128 × 32</strong><span>Routing, gain &amp; system status</span></dd></div>
        <div><dt>DIMENSIONS</dt><dd><strong>{copy.dimensionsValue}</strong>{copy.dimensionsNote && <span>{copy.dimensionsNote}</span>}</dd></div>
        <div><dt>UPDATE</dt><dd><strong>UF2 BOOTLOADER</strong><span>{copy.updateNote}</span><a class="spec-detail-link" href="https://github.com/yamamo2shun1/JUMBLEQ/blob/main/Docs/user-guide/firmware-update.md">FIRMWARE UPDATE GUIDE ↗</a></dd></div>
      </dl>
      <p class="spec-note">{copy.specNote}</p>
    </section>

    <section class="start-section" id="get-started" aria-labelledby="start-title">
      <div><p class="section-label">06 / GET STARTED</p><h2 id="start-title">{copy.startTitle[0]}<br />{copy.startTitle[1]}</h2></div>
      <div class="start-links">
        <a href="https://github.com/yamamo2shun1/JUMBLEQ/blob/main/Docs/user-guide/operation-guide.md"><span>01</span><strong>{copy.startLinks[0]}</strong><small>OPERATION GUIDE</small><b>↗</b></a>
        <a href="https://github.com/yamamo2shun1/JUMBLEQ/blob/main/Docs/user-guide/firmware-update.md"><span>02</span><strong>{copy.startLinks[1]}</strong><small>FIRMWARE</small><b>↗</b></a>
        <a href="https://github.com/yamamo2shun1/JUMBLEQ"><span>03</span><strong>{copy.startLinks[2]}</strong><small>OPEN SOURCE</small><b>↗</b></a>
      </div>
    </section>
  </main>

  <Footer {base} />
</BaseLayout>
