---
interface Props {
  base: string;
  lang?: "ja" | "en";
}

const { base, lang = "ja" } = Astro.props;
const isEnglish = lang === "en";
const languageHref = isEnglish ? `${base}ja/` : base;
---

<header class="site-header">
  <a class="brand" href="#top" aria-label={isEnglish ? "Back to the top of JUMBLEQ" : "JUMBLEQ トップへ"}>
    <img src={`${base}assets/jumbleq-logo.png`} alt="JUMBLEQ — Faderless 2CH Digital Mixer" width="1076" height="261" />
  </a>
  <nav aria-label={isEnglish ? "Main navigation" : "メインナビゲーション"}>
    <a href="#concept">Concept</a>
    <a href="#features">Features</a>
    <a href="#controls">Controls</a>
    <a href="#specs">Specs</a>
    <a href="#get-started">Get Started</a>
    <a class="language-switch" href={languageHref} lang={isEnglish ? "ja" : "en"} hreflang={isEnglish ? "ja" : "en"} aria-label={isEnglish ? "日本語版を表示" : "View this site in English"}>{isEnglish ? "JA" : "EN"}</a>
    <a class="nav-cta" href="https://configurator.jumbleq.io/">Configurator ↗</a>
  </nav>
</header>
